rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Authentication & Context Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidClientUid(uid) {
      return uid is string &&
        uid.size() >= 6 &&
        uid.size() <= 128 &&
        uid.matches('^[a-zA-Z0-9_.\\-]+$');
    }

    function isAuthorizedIdentity(uid) {
      return (isSignedIn() && request.auth.uid == uid) ||
        (request.auth == null && isValidClientUid(uid));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string &&
        id.size() > 0 &&
        id.size() <= 128 &&
        id.matches('^[a-zA-Z0-9_.\\-]+$');
    }

    function isValidInviteCode(code) {
      return code is string &&
        code.size() >= 3 &&
        code.size() <= 32 &&
        code.matches('^[A-Z0-9_\\-]+$');
    }

    function isValidUsernameHandle(username) {
      return username is string &&
        username.size() >= 2 &&
        username.size() <= 30 &&
        username.matches('^[a-z0-9_.\\-]+$');
    }

    function isValidVerifierHash(hash) {
      return hash is string &&
        hash.size() == 64 &&
        hash.matches('^[a-fA-F0-9]{64}$');
    }

    // Group Ownership & Membership Helpers
    function isGroupOwnerData(data) {
      return isSignedIn() && (
        data.createdBy == request.auth.uid ||
        (
          'memberUserIds' in data &&
          data.memberUserIds is list &&
          request.auth.uid in data.memberUserIds &&
          (
            data.memberUserIds.size() == 1 ||
            !('createdBy' in data) ||
            data.createdBy == '' ||
            data.createdBy == 'anonymous' ||
            data.createdBy.matches('^u_[a-zA-Z0-9_]+$')
          )
        )
      );
    }

    function isGroupMemberData(data) {
      return isSignedIn() && (
        request.auth.uid in data.memberUserIds ||
        data.createdBy == request.auth.uid
      );
    }

    function isGroupOwner(groupId) {
      return isSignedIn() && isValidId(groupId) && (
        (
          exists(/databases/$(database)/documents/groups/$(groupId)) &&
          isGroupOwnerData(get(/databases/$(database)/documents/groups/$(groupId)).data)
        ) ||
        (
          existsAfter(/databases/$(database)/documents/groups/$(groupId)) &&
          isGroupOwnerData(getAfter(/databases/$(database)/documents/groups/$(groupId)).data)
        )
      );
    }

    function isGroupOwnerWithCode(groupId, code) {
      return isSignedIn() && isValidId(groupId) && isValidInviteCode(code) && (
        (
          exists(/databases/$(database)/documents/groups/$(groupId)) &&
          isGroupOwnerData(get(/databases/$(database)/documents/groups/$(groupId)).data) &&
          get(/databases/$(database)/documents/groups/$(groupId)).data.inviteCode == code
        ) ||
        (
          existsAfter(/databases/$(database)/documents/groups/$(groupId)) &&
          isGroupOwnerData(getAfter(/databases/$(database)/documents/groups/$(groupId)).data) &&
          getAfter(/databases/$(database)/documents/groups/$(groupId)).data.inviteCode == code
        )
      );
    }

    function isGroupParticipant(groupId) {
      return isSignedIn() && isValidId(groupId) && (
        (
          exists(/databases/$(database)/documents/groups/$(groupId)) &&
          isGroupMemberData(get(/databases/$(database)/documents/groups/$(groupId)).data)
        ) ||
        (
          existsAfter(/databases/$(database)/documents/groups/$(groupId)) &&
          isGroupMemberData(getAfter(/databases/$(database)/documents/groups/$(groupId)).data)
        )
      );
    }

    // Member Ownership & Participant Read Helpers
    function isMemberProfileOwner(data) {
      return 'uid' in data &&
        data.uid is string &&
        data.uid.size() > 0 &&
        isAuthorizedIdentity(data.uid);
    }

    function isMemberOwner(memberId) {
      return isValidId(memberId) && (
        (
          exists(/databases/$(database)/documents/members/$(memberId)) &&
          isMemberProfileOwner(get(/databases/$(database)/documents/members/$(memberId)).data)
        ) ||
        (
          existsAfter(/databases/$(database)/documents/members/$(memberId)) &&
          isMemberProfileOwner(getAfter(/databases/$(database)/documents/members/$(memberId)).data)
        )
      );
    }

    function canReadMemberProfile(data) {
      return isSignedIn() && (
        data.uid == request.auth.uid ||
        request.auth.uid in data.memberUserIds ||
        ('groupId' in data && isGroupParticipant(data.groupId))
      );
    }

    // Parent Expense & Share Authorization Helpers
    function isExpenseParticipant(expenseId) {
      return isSignedIn() && isValidId(expenseId) && (
        (
          exists(/databases/$(database)/documents/expenses/$(expenseId)) &&
          isGroupParticipant(get(/databases/$(database)/documents/expenses/$(expenseId)).data.groupId)
        ) ||
        (
          existsAfter(/databases/$(database)/documents/expenses/$(expenseId)) &&
          isGroupParticipant(getAfter(/databases/$(database)/documents/expenses/$(expenseId)).data.groupId)
        )
      );
    }

    function isValidShareExpenseRelation(data) {
      return isSignedIn() &&
        isValidId(data.expenseId) && (
          (
            exists(/databases/$(database)/documents/expenses/$(data.expenseId)) &&
            isGroupParticipant(get(/databases/$(database)/documents/expenses/$(data.expenseId)).data.groupId) &&
            (!('groupId' in data) || data.groupId == get(/databases/$(database)/documents/expenses/$(data.expenseId)).data.groupId)
          ) ||
          (
            existsAfter(/databases/$(database)/documents/expenses/$(data.expenseId)) &&
            isGroupParticipant(getAfter(/databases/$(database)/documents/expenses/$(data.expenseId)).data.groupId) &&
            (!('groupId' in data) || data.groupId == getAfter(/databases/$(database)/documents/expenses/$(data.expenseId)).data.groupId)
          )
        );
    }

    function isAuthorizedShareRead(data) {
      return isSignedIn() && (
        ('groupId' in data && isGroupParticipant(data.groupId)) ||
        ('expenseId' in data && isExpenseParticipant(data.expenseId))
      );
    }

    // Group Owner Update vs Invite-Code Join Transition
    function isOwnerGroupUpdate() {
      return isGroupOwnerData(existing()) &&
        incoming().id == existing().id &&
        (
          incoming().createdBy == existing().createdBy ||
          incoming().createdBy == request.auth.uid
        ) &&
        (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
        (!('inviteCode' in existing()) || incoming().inviteCode == existing().inviteCode) &&
        incoming().createdBy in incoming().memberUserIds &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'baseCurrency',
          'preferredCalendar',
          'language',
          'memberUserIds',
          'inviteCode',
          'reviewNewMembers',
          'settled',
          'settledAt',
          'retentionPeriod',
          'createdBy',
          'updatedAt'
        ]);
    }

    function isParticipantSettlementStatusUpdate() {
      return isGroupMemberData(existing()) &&
        incoming().id == existing().id &&
        incoming().createdBy == existing().createdBy &&
        incoming().memberUserIds == existing().memberUserIds &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'settled',
          'settledAt',
          'updatedAt'
        ]);
    }

    function isValidInviteJoin(groupId) {
      return isSignedIn() &&
        !(request.auth.uid in existing().memberUserIds) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['memberUserIds']) &&
        'memberUserIds' in incoming() &&
        incoming().memberUserIds is list &&
        incoming().memberUserIds.size() >= 1 &&
        incoming().memberUserIds.size() <= 100 &&
        request.auth.uid in incoming().memberUserIds &&
        incoming().memberUserIds.hasAll(existing().memberUserIds) &&
        incoming().memberUserIds.size() == existing().memberUserIds.size() + 1 &&
        'inviteCode' in existing() &&
        isValidInviteCode(existing().inviteCode) &&
        exists(/databases/$(database)/documents/inviteCodes/$(existing().inviteCode)) &&
        existsAfter(/databases/$(database)/documents/inviteCodes/$(existing().inviteCode)) &&
        getAfter(/databases/$(database)/documents/inviteCodes/$(existing().inviteCode)).data.groupId == groupId &&
        getAfter(/databases/$(database)/documents/inviteCodes/$(existing().inviteCode)).data.lastJoinedBy == request.auth.uid;
    }

    // Schema Blueprints
    function isValidGroup(data) {
      return data.id is string &&
        isValidId(data.id) &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 100 &&
        data.baseCurrency is string &&
        data.baseCurrency.size() >= 2 &&
        data.baseCurrency.size() <= 10 &&
        data.createdBy is string &&
        data.createdBy.size() > 0 &&
        data.createdBy.size() <= 128 &&
        data.memberUserIds is list &&
        data.memberUserIds.size() >= 1 &&
        data.memberUserIds.size() <= 100 &&
        (!('inviteCode' in data) || isValidInviteCode(data.inviteCode));
    }

    function isValidMember(data) {
      return data.id is string &&
        isValidId(data.id) &&
        data.uid is string &&
        data.uid.size() > 0 &&
        data.uid.size() <= 128 &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 100 &&
        (!('username' in data) || (data.username is string && data.username.size() >= 2 && data.username.size() <= 40)) &&
        (!('groupId' in data) || isValidId(data.groupId)) &&
        (!('memberUserIds' in data) || (data.memberUserIds is list && data.memberUserIds.size() <= 100)) &&
        (!('passwordHash' in data) || isValidVerifierHash(data.passwordHash)) &&
        (!('pinHash' in data) || isValidVerifierHash(data.pinHash)) &&
        (!('status' in data) || data.status in ['active', 'deleted']) &&
        (!('deletedAt' in data) || (data.deletedAt is string && data.deletedAt.size() <= 64)) &&
        (!('sessionVersion' in data) || (data.sessionVersion is number && data.sessionVersion >= 1));
    }

    function isValidGroupMember(data) {
      return data.id is string &&
        isValidId(data.id) &&
        data.groupId is string &&
        isValidId(data.groupId) &&
        data.memberId is string &&
        isValidId(data.memberId);
    }

    function isValidExpense(data) {
      return data.id is string &&
        isValidId(data.id) &&
        data.groupId is string &&
        isValidId(data.groupId) &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 150 &&
        data.baseAmount is number &&
        data.baseAmount >= 0 &&
        data.baseAmount <= 1000000000 &&
        data.paidBy is string &&
        isValidId(data.paidBy);
    }

    function isValidExpenseShare(data) {
      return data.id is string &&
        isValidId(data.id) &&
        data.expenseId is string &&
        isValidId(data.expenseId) &&
        data.memberId is string &&
        isValidId(data.memberId) &&
        data.shareAmount is number &&
        data.shareAmount >= 0 &&
        data.shareAmount <= 1000000000 &&
        (!('groupId' in data) || isValidId(data.groupId));
    }

    function isValidSettlement(data) {
      return data.id is string &&
        isValidId(data.id) &&
        data.groupId is string &&
        isValidId(data.groupId) &&
        data.fromMemberId is string &&
        isValidId(data.fromMemberId) &&
        data.toMemberId is string &&
        isValidId(data.toMemberId) &&
        data.fromMemberId != data.toMemberId &&
        data.amount is number &&
        data.amount > 0 &&
        data.amount <= 1000000000;
    }

    function isValidInviteCodeDoc(data) {
      return data.groupId is string &&
        isValidId(data.groupId) &&
        data.createdBy is string &&
        data.createdBy.size() > 0 &&
        data.createdBy.size() <= 128 &&
        (!('groupName' in data) || (data.groupName is string && data.groupName.size() <= 100)) &&
        (!('lastJoinedBy' in data) || (data.lastJoinedBy is string && data.lastJoinedBy.size() > 0 && data.lastJoinedBy.size() <= 128));
    }

    function isValidRecovery(data) {
      return data.keys().hasAll(['verifierHash', 'uid']) &&
        data.keys().hasOnly(['verifierHash', 'uid', 'createdAt', 'updatedAt']) &&
        data.verifierHash is string &&
        isValidVerifierHash(data.verifierHash) &&
        data.uid is string &&
        data.uid.size() > 0 &&
        data.uid.size() <= 128;
    }

    function isValidSecurityProfile(data) {
      return data.uid is string &&
        data.uid.size() > 0 &&
        data.uid.size() <= 128 &&
        (!('hasRecoveryCode' in data) || data.hasRecoveryCode is bool) &&
        (!('recoveryCreatedAt' in data) || data.recoveryCreatedAt is string) &&
        (!('lastBackupAt' in data) || data.lastBackupAt is string);
    }

    function isValidUserDirectory(data) {
      return isValidUsernameHandle(data.username) &&
        data.memberId is string &&
        isValidId(data.memberId) &&
        data.uid is string &&
        data.uid.size() > 0 &&
        data.uid.size() <= 128 &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 100 &&
        (!('passwordHash' in data) || isValidVerifierHash(data.passwordHash)) &&
        (!('pinHash' in data) || isValidVerifierHash(data.pinHash)) &&
        (!('status' in data) || data.status in ['active', 'deleted']) &&
        (!('deletedAt' in data) || (data.deletedAt is string && data.deletedAt.size() <= 64)) &&
        (!('sessionVersion' in data) || (data.sessionVersion is number && data.sessionVersion >= 1)) &&
        data.keys().hasOnly([
          'username',
          'memberId',
          'uid',
          'name',
          'avatar',
          'color',
          'passwordHash',
          'pinHash',
          'status',
          'deletedAt',
          'sessionVersion',
          'updatedAt'
        ]);
    }

    // 1. Groups Collection
    // - Read/list restricted to group members & owner.
    // - Create requires creator ownership.
    // - Update restricted to group owner (for group management) OR atomic invite-code join by a new member.
    // - Delete restricted strictly to the group owner (`createdBy == request.auth.uid`).
    match /groups/{groupId} {
      allow get: if isValidId(groupId) && isGroupMemberData(existing());
      allow list: if isGroupMemberData(existing());
      allow create: if isSignedIn() &&
        isValidId(groupId) &&
        isValidGroup(incoming()) &&
        incoming().id == groupId &&
        incoming().createdBy == request.auth.uid &&
        request.auth.uid in incoming().memberUserIds;
      allow update: if isSignedIn() &&
        isValidId(groupId) &&
        isValidGroup(incoming()) &&
        (isOwnerGroupUpdate() || isValidInviteJoin(groupId) || isParticipantSettlementStatusUpdate());
      allow delete: if isSignedIn() &&
        isValidId(groupId) &&
        (resource == null || isGroupOwnerData(existing()));
    }

    // 2. Members Collection
    // - Mandatory `uid` on all documents (no UID-less document creation or modification).
    // - Read/list restricted to profile owner and co-participants of shared groups.
    // - Once marked `status == 'deleted'`, a member record can never be reactivated.
    match /members/{memberId} {
      allow get: if isValidId(memberId) && (canReadMemberProfile(existing()) || isMemberProfileOwner(existing()));
      allow list: if canReadMemberProfile(existing());
      allow create: if isValidId(memberId) &&
        isValidMember(incoming()) &&
        incoming().id == memberId &&
        isMemberProfileOwner(incoming());
      allow update: if isValidId(memberId) &&
        isValidMember(incoming()) &&
        incoming().id == memberId &&
        isMemberProfileOwner(incoming()) &&
        (!('status' in existing()) || existing().status != 'deleted' || ('status' in incoming() && incoming().status == 'deleted')) &&
        (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) && (
          (
            isMemberProfileOwner(existing()) &&
            existing().uid == incoming().uid
          ) ||
          (
            'status' in incoming() &&
            incoming().status == 'deleted'
          ) ||
          (
            isSignedIn() &&
            'uid' in existing() &&
            existing().uid is string &&
            existing().uid.size() > 0 &&
            'username' in incoming() &&
            isValidUsernameHandle(incoming().username) &&
            existsAfter(/databases/$(database)/documents/userDirectory/$(incoming().username)) &&
            getAfter(/databases/$(database)/documents/userDirectory/$(incoming().username)).data.memberId == memberId &&
            getAfter(/databases/$(database)/documents/userDirectory/$(incoming().username)).data.uid == request.auth.uid
          )
        );
      allow delete: if isValidId(memberId) &&
        (resource == null || isMemberProfileOwner(existing()));
    }

    // 3. GroupMembers Collection (Mapping)
    // - Read/list restricted to participants of the target group.
    // - Create/update/delete restricted to the group owner OR a verified group participant managing their own member record.
    match /groupMembers/{id} {
      allow get: if isSignedIn() && isValidId(id) && isGroupParticipant(existing().groupId);
      allow list: if isSignedIn() && isGroupParticipant(existing().groupId);
      allow create: if isSignedIn() &&
        isValidId(id) &&
        isValidGroupMember(incoming()) &&
        incoming().id == id &&
        isGroupParticipant(incoming().groupId) &&
        (isGroupOwner(incoming().groupId) || isMemberOwner(incoming().memberId));
      allow update: if isSignedIn() &&
        isValidId(id) &&
        isValidGroupMember(incoming()) &&
        incoming().id == id &&
        existing().groupId == incoming().groupId &&
        existing().memberId == incoming().memberId &&
        isGroupParticipant(existing().groupId) &&
        (isGroupOwner(existing().groupId) || isMemberOwner(existing().memberId));
      allow delete: if isSignedIn() &&
        isValidId(id) &&
        (
          resource == null ||
          isGroupOwner(existing().groupId) ||
          isMemberOwner(existing().memberId)
        );
    }

    // 4. Expenses Collection
    // - Strictly restricted to authenticated participants of the expense's group.
    match /expenses/{expenseId} {
      allow get: if isSignedIn() && isValidId(expenseId) && isGroupParticipant(existing().groupId);
      allow list: if isSignedIn() && isGroupParticipant(existing().groupId);
      allow create: if isSignedIn() &&
        isValidId(expenseId) &&
        isValidExpense(incoming()) &&
        incoming().id == expenseId &&
        isGroupParticipant(incoming().groupId);
      allow update: if isSignedIn() &&
        isValidId(expenseId) &&
        isValidExpense(incoming()) &&
        incoming().id == expenseId &&
        existing().groupId == incoming().groupId &&
        isGroupParticipant(existing().groupId);
      allow delete: if isSignedIn() &&
        isValidId(expenseId) &&
        (resource == null || isGroupParticipant(existing().groupId));
    }

    // 5. ExpenseShares Collection
    // - Verified against parent expense's group on every operation.
    match /expenseShares/{shareId} {
      allow get: if isSignedIn() && isValidId(shareId) && isAuthorizedShareRead(existing());
      allow list: if isSignedIn() && isAuthorizedShareRead(existing());
      allow create: if isSignedIn() &&
        isValidId(shareId) &&
        isValidExpenseShare(incoming()) &&
        incoming().id == shareId &&
        isValidShareExpenseRelation(incoming());
      allow update: if isSignedIn() &&
        isValidId(shareId) &&
        isValidExpenseShare(incoming()) &&
        incoming().id == shareId &&
        existing().expenseId == incoming().expenseId &&
        (!('groupId' in existing()) || existing().groupId == incoming().groupId) &&
        isValidShareExpenseRelation(incoming());
      allow delete: if isSignedIn() &&
        isValidId(shareId) &&
        (resource == null || isAuthorizedShareRead(existing()));
    }

    // 6. Settlements Collection
    // - Strictly restricted to authenticated participants of the settlement's group.
    match /settlements/{settlementId} {
      allow get: if isSignedIn() && isValidId(settlementId) && isGroupParticipant(existing().groupId);
      allow list: if isSignedIn() && isGroupParticipant(existing().groupId);
      allow create: if isSignedIn() &&
        isValidId(settlementId) &&
        isValidSettlement(incoming()) &&
        incoming().id == settlementId &&
        isGroupParticipant(incoming().groupId);
      allow update: if isSignedIn() &&
        isValidId(settlementId) &&
        isValidSettlement(incoming()) &&
        incoming().id == settlementId &&
        existing().groupId == incoming().groupId &&
        isGroupParticipant(existing().groupId);
      allow delete: if isSignedIn() &&
        isValidId(settlementId) &&
        (resource == null || isGroupParticipant(existing().groupId));
    }

    // 7. Invite Codes
    // - O(1) authenticated `get` by exact invite code; `list` enumeration forbidden.
    // - Only the group owner (`createdBy == request.auth.uid`) can create or delete an invite code matching the group's `inviteCode`.
    // - Non-owners can only update `lastJoinedBy` / `lastJoinedAt` when redeeming the code in an atomic join batch.
    match /inviteCodes/{code} {
      allow get: if isSignedIn() && isValidInviteCode(code);
      allow list: if false;
      allow create: if isSignedIn() &&
        isValidInviteCode(code) &&
        isValidInviteCodeDoc(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        isGroupOwnerWithCode(incoming().groupId, code);
      allow update: if isSignedIn() &&
        isValidInviteCode(code) &&
        isValidInviteCodeDoc(incoming()) &&
        existing().groupId == incoming().groupId &&
        existing().createdBy == incoming().createdBy && (
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['lastJoinedBy', 'lastJoinedAt']) &&
            incoming().lastJoinedBy == request.auth.uid
          ) ||
          isGroupOwnerWithCode(existing().groupId, code)
        );
      allow delete: if isSignedIn() &&
        isValidInviteCode(code) &&
        (
          resource == null ||
          existing().createdBy == request.auth.uid ||
          isGroupOwner(existing().groupId)
        );
    }

    // 8. Account Recovery
    // - Strictly isolated to the owning UID (`uid == request.auth.uid`) for get, create, update, and delete; `list` forbidden.
    // - Prevents any cross-user recovery-data disclosure or tampering.
    match /recovery/{verifierHash} {
      allow get: if isSignedIn() &&
        isValidVerifierHash(verifierHash) &&
        existing().uid == request.auth.uid;
      allow list: if false;
      allow create: if isSignedIn() &&
        isValidVerifierHash(verifierHash) &&
        isValidRecovery(incoming()) &&
        incoming().verifierHash == verifierHash &&
        incoming().uid == request.auth.uid;
      allow update: if isSignedIn() &&
        isValidVerifierHash(verifierHash) &&
        isValidRecovery(incoming()) &&
        incoming().verifierHash == verifierHash &&
        existing().uid == request.auth.uid &&
        incoming().uid == request.auth.uid;
      allow delete: if isSignedIn() &&
        isValidVerifierHash(verifierHash) &&
        (resource == null || existing().uid == request.auth.uid);
    }

    // 9. Security Profiles (Strictly isolated to owner UID)
    match /securityProfiles/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if isSignedIn() &&
        isValidId(uid) &&
        request.auth.uid == uid &&
        isValidSecurityProfile(incoming()) &&
        incoming().uid == request.auth.uid;
      allow delete: if isSignedIn() &&
        isValidId(uid) &&
        request.auth.uid == uid;
    }

    // 10. User Directory (O(1) handle lookup; list forbidden; centralized account status & sessionVersion source of truth)
    match /userDirectory/{username} {
      allow get: if isValidUsernameHandle(username);
      allow list: if false;
      allow create: if isValidUsernameHandle(username) &&
        isValidUserDirectory(incoming()) &&
        incoming().username == username &&
        isAuthorizedIdentity(incoming().uid) &&
        isMemberOwner(incoming().memberId);
      allow update: if isValidUsernameHandle(username) &&
        isValidUserDirectory(incoming()) &&
        incoming().username == username &&
        isAuthorizedIdentity(incoming().uid) && (
          // Case A: Account is currently active; owner or verified user updates profile or marks status == 'deleted'
          (
            (!('status' in existing()) || existing().status != 'deleted') &&
            existing().memberId == incoming().memberId && (
              (
                existing().uid == incoming().uid &&
                isAuthorizedIdentity(existing().uid) &&
                isMemberOwner(incoming().memberId)
              ) ||
              (
                'status' in incoming() &&
                incoming().status == 'deleted'
              ) ||
              (
                isSignedIn() &&
                'passwordHash' in incoming() &&
                isValidVerifierHash(incoming().passwordHash) && (
                  !('passwordHash' in existing()) ||
                  incoming().passwordHash == existing().passwordHash
                )
              )
            )
          ) ||
          // Case B: Previously deleted handle is freshly registered with a brand-new memberId
          (
            'status' in existing() &&
            existing().status == 'deleted' &&
            'status' in incoming() &&
            incoming().status == 'active' &&
            incoming().memberId != existing().memberId &&
            isMemberOwner(incoming().memberId)
          )
        );
      allow delete: if isValidUsernameHandle(username) &&
        (resource == null || (isAuthorizedIdentity(existing().uid) && isMemberOwner(existing().memberId)));
    }
  }
}
