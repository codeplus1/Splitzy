{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(sw\\.js|workbox-.*\\.js|manifest\\.webmanifest|manifest\\.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|api/|favicon\\.ico|apple-touch-icon\\.png|icon\\.svg|icon-maskable\\.svg|pwa-192x192\\.png|pwa-512x512\\.png|pwa-maskable-512x512\\.png|manifest\\.json|manifest\\.webmanifest|sw\\.js|workbox-.*\\.js).*)",
      "destination": "/index.html"
    }
  ]
}
